{
  "name": "@businessnjgovnavigator/root",
  "version": "2026.19.1",
  "description": "This is the development repository for the work-in-progress business navigator from the New Jersey Office of Innovation. For info on the existing [Business.NJ.gov](https://business.nj.gov) site, please see the [bottom of this document](https://github.com/newjersey/navigator.business.nj.gov#businessnjgov)",
  "main": "index.js",
  "private": true,
  "scripts": {
    "esbuild": "esbuild",
    "build": "pnpm verify:node && pnpm decap:build-config && pnpm cms:map && pnpm --filter @businessnjgovnavigator/content-types run build && pnpm --filter @businessnjgovnavigator/content run build && pnpm --filter @businessnjgovnavigator/shared run build && pnpm --filter @businessnjgovnavigator/api --filter @businessnjgovnavigator/api-cdk --filter @businessnjgovnavigator/react-email --filter @businessnjgovnavigator/web run build && pnpm --filter @businessnjgovnavigator/static-site run build",
    "build:clean": "pnpm clean && pnpm build",
    "clean": "pnpm -r --if-present run clean",
    "cms:proxy": "pnpm exec decap-server",
    "cms:map": "pnpm exec tsx scripts/generate-collection-map.ts",
    "decap:build-config": "pnpm run prettier:yamlInput && pnpm exec tsx scripts/merge-decap-config.ts && pnpm run prettier:yamlOutput",
    "dependency-check": "pnpm --filter '!@businessnjgovnavigator/static-site' -r --if-present run dependency-check",
    "services:up": "docker-compose -f docker-compose.yml up -d",
    "services:down": "docker-compose -f docker-compose.yml down",
    "dynamodb:admin": "docker-compose -f docker-compose.yml up -d dynamodb-admin && python -m webbrowser -t http://localhost:8001",
    "dynamo:logs": "docker-compose -f docker-compose.yml logs -f dynamodb-local",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "prettier": "prettier --write . --ignore-path=./.eslintignore",
    "prettier:yamlInput": "prettier -w \"web/decap-config/**/*.{yml,yaml}\"",
    "prettier:yamlOutput": "prettier -w web/public/mgmt/config.yml",
    "prettier:check": "prettier --check . --ignore-path=./.eslintignore && pnpm --filter @businessnjgovnavigator/static-site run format:check",
    "spellcheck": "cspell '*.md' --config cspell.json --no-progress && pnpm -r --if-present run spellcheck",
    "start:dev": "node scripts/start-dev.js",
    "test": "jest",
    "test:browser": "pnpm --filter @businessnjgovnavigator/static-site run test:accessibility && pnpm --filter @businessnjgovnavigator/static-site run test:e2e:all",
    "test:ci": "jest --colors --runInBand --ci",
    "test:content": "pnpm --filter @businessnjgovnavigator/content run test",
    "test:coverage": "jest --config jest.coverage.ts",
    "test:dependency-policy": "tsx --test scripts/validate-dependency-policy.test.ts",
    "test:python": "python -m unittest discover -b -s content/scripts -p \"test_*.py\" && python -m unittest discover -b -s scripts -p \"test_*.py\"",
    "test:static-site": "pnpm --filter @businessnjgovnavigator/static-site run test",
    "test:watch": "pnpm test --watch",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate:dependencies": "tsx scripts/validate-dependency-policy.ts",
    "verify:node": "check-node-version --node $(cat .nvmrc) --pnpm 12.3.4",
    "wipit": "git add -A && git commit -m 'wip [skip ci]' --no-verify",
    "cms:check-slugs": "tsx scripts/check-decap-slug-collisions.ts"
  },
