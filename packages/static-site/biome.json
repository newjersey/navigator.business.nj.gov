{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 80 }
        },
        "useMaxParams": {
          "level": "error",
          "options": { "max": 2 }
        }
      },
      "style": {
        "noProcessEnv": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Use @/ absolute imports instead of parent-relative imports."
              }
            ]
          }
        }
      }
    }
  }
}
