# Runtime variables
# When "true", enables HTTP Basic Auth on the deployment
USE_BASIC_AUTH=
# Required when USE_BASIC_AUTH=true
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Build-time variables (inlined by Next.js at build)
NEXT_PUBLIC_MULTILINGUAL_ENABLED=
NEXT_PUBLIC_SURVEY_MONKEY_ENABLED=
# Feedback widget behavior: "prod" (real submissions), "mock" (renders, stubs
# network calls), or "off" (not rendered). Unset or unrecognized values are
# treated as "off".
NEXT_PUBLIC_FEEDBACK_WIDGET_MODE=
NEXT_PUBLIC_WEB_BASE_URL=
