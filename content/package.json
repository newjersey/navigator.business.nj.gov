{
  "name": "@businessnjgovnavigator/content",
  "version": "1.0.0",
  "description": "A content library for the business.nj.gov navigator",
  "private": true,
  "license": "MIT",
  "main": "src",
  "scripts": {
    "build": "tsx -r tsconfig-paths/register ./build.ts",
    "clean": "rimraf lib",
    "dev": "yarn build",
    "test": "vitest run",
    "validate-frontmatter-dates": "tsx -r tsconfig-paths/register ./validateFrontmatterDates.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "spellcheck": "cspell '**/*.md' '**/*.json' '*.ts' '!*.test.ts' --config ../cspell.json --no-progress"
  },
  "dependencies": {
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@businessnjgovnavigator/content-types": "*",
    "@businessnjgovnavigator/shared": "*",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.9",
    "cross-env": "10.1.0",
    "cspell": "9.8.0",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
