{
  "name": "@businessnjgovnavigator/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "airtable:dump": "node src/scripts/airtableDump.js",
    "airtable:fetch-opps": "node src/scripts/airtableOpportunityDump.js",
    "analyze": "next experimental-analyze",
    "build": "pnpm copy-vendor-assets && next build && pnpm run sitemap",
    "build-storybook": "storybook build -o .storybook/build",
    "clean": "rimraf .next public/vendor",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --record false",
    "cypress:run:feature": "cypress run --record false --env SUITE=feature",
    "cypress:run:ci": "cypress run --record false --env SUITE=ci",
    "copy-vendor-assets": "tsx ./copyVendorAssets.ts",
    "dev": "pnpm copy-vendor-assets && next dev",
    "eslint": "eslint",
    "export:funding": "ts-node ./src/scripts/fundingExport.mjs",
    "dependency-check": "pnpm exec depcruise --config .dependency-cruiser.js src",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "prettier": "prettier --write . --ignore-path=./.eslintignore",
    "prettier:check": "prettier . --check --ignore-path=./.eslintignore",
    "sitemap": "pnpm exec tsx src/scripts/generateSitemap.mts",
    "snapshot:update": "jest --updateSnapshot",
    "spellcheck": "cspell '**/*.md' '**/*.yml' 'src/**/*.json' 'src/**/*.{ts,tsx}' '!**/*.test.{ts,tsx}' --config ../cspell.json --no-progress",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "cross-env-shell DEBUG_PRINT_LIMIT=50000 jest",
    "typecheck": "tsc --noemit",
    "typecheck:cypress": "tsc --noemit --project cypress/tsconfig.json",
    "webflow:run-sync": "pnpm run webflow:fundings-sync && pnpm run webflow:industries-sync && pnpm run webflow:licenses-sync",
    "webflow:fundings-sync": "tsx ./src/scripts/webflow/fundingSync.ts",
    "webflow:industries-sync": "tsx ./src/scripts/webflow/industrySync.ts",
    "webflow:licenses-sync": "tsx ./src/scripts/webflow/licenseSync.ts",
    "webflow:categories-pull": "tsx ./src/scripts/webflow/categoryPull.ts",
    "webflow:covids-pull": "tsx ./src/scripts/webflow/covidPull.ts",
    "webflow:faq-pull": "tsx ./src/scripts/webflow/faqPull.ts",
    "webflow:pages-pull": "tsx ./src/scripts/webflow/pagePull.ts",
    "webflow:recents-pull": "tsx ./src/scripts/webflow/recentPull.ts",
    "webflow:tropical-storm-ida-pull": "tsx ./src/scripts/webflow/tropicalStormIdaPull.ts",
    "webflow:license-department-website-pull": "tsx ./src/scripts/webflow/licenseDepartmentWebsitePull.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-browser": "5.2.0",
