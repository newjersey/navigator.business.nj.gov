{
  "name": "@businessnjgovnavigator/api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm generate:user-schema && tsc --project tsconfig.json",
    "prestart": "pnpm generate:user-schema",
    "generate:user-schema": "tsx scripts/generateUserSchemaFile.ts",
    "clean": "rimraf cdk/cdk.out",
    "dev": "concurrently \"pnpm start:wiremock\" \"pnpm start:hotReload\"",
    "dependency-check": "pnpm exec depcruise --config .dependency-cruiser.js src",
    "install-dynamo-local": "./scripts/dynamodb-local.sh",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "prettier": "prettier --write . --ignore-path=./.eslintignore",
    "prettier:check": "prettier . --check --ignore-path=./.eslintignore",
    "print:user-schema:zod": "tsx scripts/printUserZodSchema.ts --zod",
    "print:user-schema:json": "tsx scripts/printUserZodSchema.ts --json",
    "print:user-schema:ts": "tsx scripts/printUserZodSchema.ts --ts",
    "print:user-schema:ts-zod": "tsx scripts/printUserZodSchema.ts --ts-zod",
    "print:user-schema:diff": "bash scripts/diffUserSchemas.sh",
    "spellcheck": "cspell 'src/**/*.ts' 'scripts/**/*.{ts,mjs}' '!**/*.test.ts' '!src/domain/userSchema.generated.ts' --config ../cspell.json --no-progress",
    "start": "concurrently --names \"Express,HealthCheck,UpdateExternal,EncryptTax,GitHubOAuth,MigrateUsers,KillSwitch\" \"tsx -r dotenv/config -r tsconfig-paths/register src/functions/express/app.ts\" \"tsx -r dotenv/config -r tsconfig-paths/register src/functions/healthCheck/app.ts\" \"tsx -r dotenv/config -r tsconfig-paths/register src/functions/updateExternalStatus/app.ts\" \"tsx -r dotenv/config -r tsconfig-paths/register src/functions/encryptTaxId/app.ts\" \"tsx -r dotenv/config -r tsconfig-paths/register src/functions/githubOauth2/app.ts\" \"tsx -r dotenv/config -r tsconfig-paths/register src/functions/migrateUsersVersion/app.ts\" \"tsx -r dotenv/config -r tsconfig-paths/register src/functions/updateKillSwitchParameter/app.ts\"",
    "start:hotReload": "concurrently --names \"Express,HealthCheck,UpdateExternal,EncryptTax,GitHubOAuth,MigrateUsers,KillSwitch\" \"tsx watch -r dotenv/config -r tsconfig-paths/register src/functions/express/app.ts\" \"tsx watch -r dotenv/config -r tsconfig-paths/register src/functions/healthCheck/app.ts\" \"tsx watch -r dotenv/config -r tsconfig-paths/register src/functions/updateExternalStatus/app.ts\" \"tsx watch -r dotenv/config -r tsconfig-paths/register src/functions/encryptTaxId/app.ts\" \"tsx watch -r dotenv/config -r tsconfig-paths/register src/functions/githubOauth2/app.ts\" \"tsx watch -r dotenv/config -r tsconfig-paths/register src/functions/migrateUsersVersion/app.ts\" \"tsx watch -r dotenv/config -r tsconfig-paths/register src/functions/updateKillSwitchParameter/app.ts\"",
    "start:wiremock": "wiremock --root-dir ./wiremock --port 9000",
    "start:wiremock:with-port": "wiremock --root-dir ./wiremock",
    "test": "jest",
    "typecheck": "tsc --noemit",
    "cms-integrity-tests": "pnpm exec tsx ./scripts/cms-content-integrity-tests/runCmsIntegrityTests.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@aws-crypto/client-node": "5.0.2",
    "@aws-crypto/material-management-node": "5.0.2",
    "@aws-crypto/serialize": "5.0.2",
    "@aws-sdk/client-cloudwatch": "3.1129.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1129.0",
    "@aws-sdk/client-dynamodb": "3.1129.0",
    "@aws-sdk/client-lambda": "3.1129.0",
    "@aws-sdk/client-s3": "3.1129.0",
    "@aws-sdk/client-ses": "3.1129.0",
    "@aws-sdk/client-sns": "3.1129.0",
    "@aws-sdk/client-ssm": "3.1129.0",
    "@aws-sdk/lib-dynamodb": "3.1129.0",
    "@aws-sdk/types": "3.974.5",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@businessnjgovnavigator/shared": "workspace:*",
    "@smithy/node-http-handler": "4.12.1",
    "@smithy/util-base64": "4.6.2",
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "dedent": "1.7.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "serverless-http": "4.0.0",
    "simple-oauth2": "5.1.0",
    "uuid": "14.0.2",
    "winston": "3.19.0",
    "winston-cloudwatch": "6.3.0",
    "xml2js": "0.6.2",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1129.0",
    "@jest/environment": "30.5.1",
    "@jest/types": "30.5.1",
    "@types/cors": "2.8.19",
    "@types/dedent": "0.7.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.4",
    "@types/simple-oauth2": "5.0.8",
    "@types/supertest": "7.2.1",
    "@types/xml2js": "0.4.14",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "cli-highlight": "2.1.11",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "cspell": "10.3.0",
    "dependency-cruiser": "18.2.0",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jest-formatting": "3.1.0",
    "eslint-plugin-unicorn": "51.0.1",
    "jest": "30.5.1",
    "jest-dynalite": "3.6.1",
    "jest-environment-node": "30.5.1",
    "jest-junit": "17.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "wiremock": "3.13.2"
  }
}
