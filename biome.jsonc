{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@newjersey/biome-config/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!.claude",
      "!packages/static-site",
      "!packages/content-types",
      "!scripts",
      "!web/stories",
      "!web/cypress/support",
      "!web/cypress/plugins",
      "!api/wiremock/__files/tax-clearance-success.json",
      "!**/public",
      "!**/*.svg",
      "!**/*.min.js",
      "!**/*.html"
    ]
  },
  // Decap writes content Markdown without hooks; Prettier keeps Markdown for now.
  "markdown": {
    "parser": { "frontmatter": true },
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "overrides": [
    {
      "includes": ["shared/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["api/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "PascalCase"]
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [".", "..", "./**", "../**"],
                    "message": "Use path-alias imports instead of relative imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["api/src/db/migrations/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["snake_case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "api/cdk/**",
        "api/scripts/**",
        "api/src/functions/messagingService/reactEmail/**"
      ],
      "linter": {
        "rules": {
          "style": {
            // api's path aliases don't cover these dirs:
            // cdk and reactEmail have their own tsconfig; scripts import each other.
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["api/.dependency-cruiser.mjs", "api/jest-dynalite-config.cjs"],
      "linter": {
        "rules": {
          "style": {
            // jest-dynalite only finds jest-dynalite-config.*; .dependency-cruiser is depcruise's conventional name
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case", "camelCase", "PascalCase"]
              }
            }
          },
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "h5": "Use h1-h4; h5 and h6 are not part of the design system.",
                  "h6": "Use h1-h4; h5 and h6 are not part of the design system."
                }
              }
            },
            "useExhaustiveDependencies": {
              "level": "error",
              "options": {
                "reportUnnecessaryDependencies": false
              }
            },
            "noBeforeInteractiveScriptOutsideDocument": "error",
            "noNextAsyncClientComponent": "error"
          },
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": ["Checkbox"]
              }
            },
            "noNoninteractiveElementInteractions": "error"
          },
          "performance": {
            // ported from ESLint's explicit @next/next/no-img-element: off; AB#18079 evaluates Next's image optimizer
            "noImgElement": "off",
            "noSyncScripts": "error"
          },
          "suspicious": {
            "noUnknownAttribute": "error",
            // web has no logger, so allow console.error/warn for its runtime error reporting
            "noConsole": {
              "level": "error",
              "options": { "allow": ["error", "warn"] }
            }
          }
        }
      }
    },
    {
      "includes": ["shared/**", "api/**", "web/**"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "error",
            "noSubstr": "error",
            "useAsConstAssertion": "error",
            "useCollapsedIf": "error",
            "useExplicitLengthCheck": "error",
            "useForOf": "error",
            "useNumberNamespace": "error",
            "useThrowNewError": "error",
            "useTrimStartEnd": "error"
          },
          "suspicious": {
            "noEmptySource": "error",
            "useErrorMessage": "error",
            "useNumberToFixedDigitsArgument": "error"
          }
        }
      }
    },
    {
      "includes": ["shared/**/*.test.*", "api/**/*.test.*", "web/**/*.test.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "useExpect": "error"
          }
        }
      }
    },
    {
      "includes": ["web/**/*.scss"],
      "linter": {
        "rules": {
          // !important is how web overrides USWDS/MUI specificity
          "complexity": { "noImportantStyles": "off" },
          // ignores whether selectors set the same property; fixing reorders the cascade
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      "includes": ["content/build.ts", "content/validateFrontmatterDates.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            // CLI build scripts report progress to stdout
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["web/src/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // CLI scripts report to stdout
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["api/scripts/**", "api/src/functions/messagingService/reactEmail/build.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            // CLI scripts report to stdout
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["api/src/libs/logWriter.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            // the logger is where console output is supposed to live
            "noConsole": "off"
          }
        }
      }
    },
    // Decap re-serializes these on save.
    {
      "includes": ["content/src/**/*.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.test.*", "web/test/**"],
      "linter": {
        "rules": {
          "style": {
            // tests assert on fixtures they built; a wrong assumption fails the test loudly
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["web/**/*.test.*", "web/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // web test fixtures use ${name} as CMS and templateEval placeholder syntax
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    // Fixing these changes runtime behavior, so each has its own ticket.
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "correctness": {
            // AB#18077
            "useExhaustiveDependencies": {
              "level": "off",
              "options": { "reportUnnecessaryDependencies": false }
            },
            // AB#18078
            "noComponentHookFactories": "off"
          },
          // AB#18076
          "nursery": { "noFloatingPromises": "off" }
        }
      }
    }
  ]
}
