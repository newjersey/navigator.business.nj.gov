{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@newjersey/biome-config/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.yarn/*",
      "!pnpm-lock.yaml",
      "!.claude",
      "!packages/static-site",
      "!packages/content-types",
      "!scripts",
      "!web/stories",
      "!web/cypress/support",
      "!web/cypress/plugins",
      "!api/wiremock/__files/tax-clearance-success.json",
      "!**/public",
      "!**/*.svg",
      "!**/*.min.js",
      "!**/*.html"
    ]
  },
  // Decap writes content Markdown without hooks; Prettier keeps Markdown for now.
  "markdown": {
    "parser": { "frontmatter": true },
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  // yarn build runs decap:build-config, which runs prettier -w on web/decap-config; Biome moves YAML in a later PR.
  "yaml": { "formatter": { "enabled": false } },
  "overrides": [
    {
      "includes": ["shared/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["api/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "PascalCase"]
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [".", "..", "./**", "../**"],
                    "message": "Use path-alias imports instead of relative imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["api/src/db/migrations/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["snake_case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "api/cdk/**",
        "api/scripts/**",
        "api/src/functions/messagingService/reactEmail/**"
      ],
      "linter": {
        "rules": {
          "style": {
            // api's path aliases don't cover these dirs:
            // cdk and reactEmail have their own tsconfig; scripts import each other.
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case", "camelCase", "PascalCase"]
              }
            }
          },
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "h5": "Use h1-h4; h5 and h6 are not part of the design system.",
                  "h6": "Use h1-h4; h5 and h6 are not part of the design system."
                }
              }
            },
            "useExhaustiveDependencies": {
              "level": "error",
              "options": {
                "reportUnnecessaryDependencies": false
              }
            },
            "noBeforeInteractiveScriptOutsideDocument": "error",
            "noNextAsyncClientComponent": "error"
          },
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": ["Checkbox"]
              }
            },
            "noNoninteractiveElementInteractions": "error"
          },
          "performance": {
            "noImgElement": "off",
            "noSyncScripts": "error"
          },
          "suspicious": {
            "noUnknownAttribute": "error"
          }
        }
      }
    },
    {
      "includes": ["shared/**", "api/**", "web/**"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "error",
            "noSubstr": "error",
            "useAsConstAssertion": "error",
            "useCollapsedIf": "error",
            "useExplicitLengthCheck": "error",
            "useForOf": "error",
            "useNumberNamespace": "error",
            "useThrowNewError": "error",
            "useTrimStartEnd": "error"
          },
          "suspicious": {
            "noEmptySource": "error",
            "useErrorMessage": "error",
            "useNumberToFixedDigitsArgument": "error"
          }
        }
      }
    },
    {
      "includes": ["shared/**/*.test.*", "api/**/*.test.*", "web/**/*.test.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "useExpect": "error"
          }
        }
      }
    },
    {
      "includes": ["web/**/*.scss"],
      "linter": {
        "rules": {
          // !important is how web overrides USWDS/MUI specificity
          "complexity": { "noImportantStyles": "off" },
          // ignores whether selectors set the same property; fixing reorders the cascade
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    // VS Code organizeImports: Biome's and TS's sorters fight over alias order in unmigrated workspaces.
    {
      "includes": ["api/**", "!api/cdk/**"],
      "assist": { "enabled": false }
    },
    {
      "includes": ["content/build.ts", "content/validateFrontmatterDates.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            // CLI build scripts report progress to stdout
            "noConsole": "off"
          }
        }
      }
    },
    // Decap re-serializes these on save.
    {
      "includes": ["content/src/**/*.json"],
      "formatter": {
        "enabled": false
      }
    },
    // Deferred to AB#18076 (noFloatingPromises), AB#18077 (useExhaustiveDependencies), and AB#18078 (noComponentHookFactories); decided when ESLint is removed.
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "warn",
              "options": { "reportUnnecessaryDependencies": false }
            },
            "noComponentHookFactories": "warn"
          },
          "nursery": { "noFloatingPromises": "warn" }
        }
      }
    },
    // temporary: drained by the web rule PRs.
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "warn",
            "noAriaHiddenOnFocusable": "warn",
            "noRedundantRoles": "warn",
            "useSemanticElements": "warn",
            "useAriaPropsSupportedByRole": "warn",
            "useValidAriaRole": "warn",
            "noLabelWithoutControl": {
              "level": "warn",
              "options": { "inputComponents": ["Checkbox"] }
            },
            "useValidAriaValues": "warn",
            "useValidAnchor": "warn",
            "noStaticElementInteractions": "warn",
            "noNoninteractiveElementInteractions": "warn"
          },
          "suspicious": {
            "noConsole": "warn",
            "noExplicitAny": "warn",
            "noArrayIndexKey": "warn",
            "useIterableCallbackReturn": "warn",
            "noImplicitAnyLet": "warn",
            "noAssignInExpressions": "warn",
            "noShadowRestrictedNames": "warn",
            "noRedeclare": "warn",
            "useExpect": "warn"
          },
          "style": {
            "noCommonJs": "warn",
            "useThrowOnlyError": "warn",
            "noParameterAssign": "warn",
            "useFilenamingConvention": {
              "level": "warn",
              "options": { "filenameCases": ["kebab-case", "camelCase", "PascalCase"] }
            }
          },
          "correctness": {
            "useHookAtTopLevel": "warn",
            "noUnknownProperty": "warn",
            "noVoidTypeReturn": "warn",
            "noUnreachable": "warn"
          },
          "complexity": { "useMaxParams": "warn" },
          "security": { "noDangerouslySetInnerHtml": "warn" }
        }
      }
    }
  ]
}
